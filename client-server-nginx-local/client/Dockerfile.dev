# Development Dockerfile for the React frontend (used by docker-compose.yml).
FROM node:lts-alpine
WORKDIR '/app'

# Copy package manifests first so Docker caches dependency installation across source-code-only edits.
COPY ./package*.json ./
RUN npm ci

# Copy the remaining application source code (overridden at runtime by a bind mount in docker-compose.yml).
COPY . .

# Start Vite's live-reloading development server on port 3000.
CMD ["npm", "run", "start"]
