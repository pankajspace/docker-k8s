# Copy this file to .env on your EC2 instance before running docker compose.

# Subdomain pointing to your EC2 Elastic IP (used by Nginx and Certbot for HTTPS).
API_DOMAIN=api.fib1.techtoday.click

# Comma-separated frontend origins allowed by Express CORS (no trailing slashes).
CLIENT_ORIGIN=https://fib1.techtoday.click

# Optional email for Let's Encrypt certificate notifications (used by Certbot).
ACME_EMAIL=admin@techtoday.click
