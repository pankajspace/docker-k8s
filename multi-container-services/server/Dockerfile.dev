# Development Dockerfile for the Express API server (used by docker-compose.yml).
FROM node:lts-alpine
WORKDIR "/app"

# Copy package.json first to leverage Docker layer caching during dependency installation.
COPY ./package.json ./
RUN npm install

# Copy the server source code (overridden at runtime by a bind mount in docker-compose.yml).
COPY . .

# Run with nodemon so the API server automatically restarts whenever source files change.
CMD ["npm", "run", "dev"]
